{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/expo-react-native.md",
    "docs/project-brief.md",
    ".opencode/docs/pipeline.md",
    ".opencode/docs/directive-sync.md"
  ],
  "default_agent": "orchestrator",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "gh *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm lint *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "pnpm exec tsc --noEmit *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm exec expo install *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm dlx expo-doctor *",
      "effect": "allow"
    },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "git push --force-with-lease *",
      "effect": "deny"
    },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" }
  ],
  "plugins": ["@dietrichgebert/ponytail"],
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["npx", "@colbymchenry/codegraph", "serve", "--mcp"],
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{file:.opencode/secrets/context7-api-key}"
        },
        "disabled": false
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", ".expo/**", "dist/**", "coverage/**"]
  }
}
