{
  "expo": {
    "name": "Tasks",
    "slug": "Tasks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tasks",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_CONTACTS"
      ],
      "blockedPermissions": ["android.permission.WRITE_CONTACTS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f9fb",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
            "node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
            "node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/geist/700Bold/Geist_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#091426",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permití que Tasks acceda a tus fotos para adjuntar una imagen a una tarea.",
          "cameraPermission": "Permití que Tasks use la cámara para adjuntar una foto a una tarea.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permití que Tasks use tu ubicación para asociar un lugar a una tarea."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permití que Tasks acceda a tus contactos para asociar un responsable a una tarea."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Permití que Tasks acceda a tu calendario para crear eventos de tareas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
